# Email Configuration
# These settings are REQUIRED - you cannot use any random values
# Contact your email provider or IT administrator for the correct values

# Sender email address
EMAIL_FROM=a.samy@ash-translation.co.uk

# SMTP Server (Host) - Examples:
#   Office 365/Microsoft 365: smtp.office365.com
#   Gmail: smtp.gmail.com
#   Custom domain: smtp.yourdomain.com or mail.yourdomain.com
#   Contact your email provider for the correct SMTP server address
EMAIL_HOST=smtp.office365.com

# SMTP Port - Common values:
#   587 = STARTTLS (recommended for most providers)
#   465 = SSL/TLS (older method)
#   25 = Unencrypted (not recommended, often blocked)
#   Use 587 for Office 365, Gmail, and most modern email providers
EMAIL_PORT=587

# Email Username - Usually your full email address
# For Office 365/Gmail: Use your full email address (a.samy@ash-translation.co.uk)
EMAIL_USERNAME=a.samy@ash-translation.co.uk

# Email Password - Your email account password
# For Gmail: You may need to use an App Password instead of your regular password
# For Office 365: Use your regular password or App Password if MFA is enabled
EMAIL_PASSWORD=your-email-password-here

# Database Configuration
# DB_CONNECTION_STRING=your_connection_string_here

# JWT Configuration
# SecurityKey=your_security_key_here
# Issuer=your_issuer_here
# audience=your_audience_here
